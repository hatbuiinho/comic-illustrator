# Artifact sinh trong quá trình xử lý từng page
outputs/
**/qa/**
!**/qa/README.md
**/tmp/
**/Part */pages/

# Dữ liệu sinh khi tạo hình trong hai studio (giữ README hướng dẫn)
/studios/**
!/studios/**/
!/studios/**/README.md

# Dữ liệu sinh khi chạy flow TTPQ Comic (giữ nguồn và README hướng dẫn)
/ttpq-comic/spreads/**
!/ttpq-comic/spreads/**/
!/ttpq-comic/spreads/**/README.md

# Cache Python của script workflow
__pycache__/
*.py[cod]

# Hàng đợi/trạng thái runtime của workflow
sentry/queue/

# Metadata cục bộ của hệ điều hành
.DS_Store

# Toolchain cục bộ theo máy (chỉ track manifest; bin, mamba, state... đều bỏ qua)
# Thư mục chỉ có trên một máy: thêm vào .git/info/exclude của máy đó,
# không sửa file này mà không commit để tránh conflict khi pull/stash.
.venv/
.tools/*
!.tools/macos-tools.json
!.tools/windows-tools.json

# Ảnh sinh tạm của agent
local
generated_images/
