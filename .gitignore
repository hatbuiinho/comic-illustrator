# Artifact sinh trong quá trình xử lý từng page
outputs/
**/qa/**
!**/qa/README.md
**/tmp/
**/Part */pages/

# Dữ liệu sinh khi tạo hình trong hai studio (giữ README hướng dẫn)
/studios/**
!/studios/**/
!/studios/**/README.md

# Dữ liệu sinh khi chạy flow TTPQ Comic (giữ nguồn và README hướng dẫn)
/ttpq-comic/spreads/**
!/ttpq-comic/spreads/**/
!/ttpq-comic/spreads/**/README.md

# Cache Python của script workflow
__pycache__/
*.py[cod]

# Hàng đợi/trạng thái runtime của workflow
sentry/queue/

# Metadata cục bộ của hệ điều hành
.DS_Store

# Toolchain cục bộ theo máy
.venv/
.tools/state.windows.json
.tools/state.macos.json

local
